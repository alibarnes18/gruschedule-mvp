# Copy to .env.local and fill in from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, used by Edge Functions for writes.
# Never expose this to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot token from @BotFather — only needed by the
# telegram-webhook/notify-changes Edge Functions (Faz 5), set as a Supabase
# Edge Function secret (`supabase secrets set TELEGRAM_BOT_TOKEN=...`), not
# used by the Next.js app itself.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram chat ID to alert when a parse comes back "failed" or
# "needs_review" (e.g. the university changed a PDF's layout). Get your own
# chat ID by messaging the bot once, then checking notification_subscriptions
# or https://api.telegram.org/bot<token>/getUpdates. Also a Supabase Edge
# Function secret, not used by the Next.js app.
TELEGRAM_ADMIN_CHAT_ID=
